# BenchHub BFF — environment variables.
# Validated at startup by src/config/env.ts: the process refuses to start on any invalid value.
# Copy to `.env` for local development. Empty values count as "not set". Never commit a real `.env`.

# ── Runtime ──────────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# HTTP port for local runs (0-65535; 0 = pick a free port).
PORT=3001
# Injected by Databricks Apps (ADR-0007); overrides PORT when set. Leave empty locally.
DATABRICKS_APP_PORT=
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# OpenTelemetry instrumentation: true | false (keep false until a collector exists).
OTEL_ENABLED=false
# Requests per minute per client IP. Production: 300. Local e2e stack: raise it (e.g. 5000).
RATE_LIMIT_PER_MINUTE=300

# ── Sessions ─────────────────────────────────────────────────────────────────────────
# Session signing secret, >= 32 random characters. REQUIRED when NODE_ENV=production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# memory (single instance) | lakebase (not available until Phase 4, ADR-0004)
SESSION_STORE=memory

# ── Data providers ───────────────────────────────────────────────────────────────────
# mock (fixtures) | real (Databricks / Entra ID; later phases)
PROVIDERS_DEFAULT=mock

# ── Mock provider (only used when PROVIDERS_DEFAULT=mock) ────────────────────────────
# default | empty | error | slow | partial | forbidden
MOCK_SCENARIO=default
# Extra latency added by mock providers, in ms (integer >= 0).
MOCK_LATENCY_MS=0
# Role of the mock session:
# analyst_creator | explorer_viewer | explorer_integral | executive_viewer | executive_integral
MOCK_ROLE=analyst_creator
# The single credential pair accepted by the mock username/password login (A-05).
# Demo values only; the real login is OIDC with Entra ID (A-01/A-02). Change them in any shared environment.
MOCK_LOGIN_USERNAME=ecopetrol@ecopetrol.com
MOCK_LOGIN_PASSWORD=ecopetrol
